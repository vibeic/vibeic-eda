# syntax=docker/dockerfile:1
#
# 0.3.48, built as a DERIVED image on top of the 0.3.47 digest.
#
# ONE CHANGE FROM 0.3.47, AND NOTHING ELSE. openroad is rebuilt from this org's
# fork at master, which now carries #20 -- getDRCMarkers kept every marker every
# tiled GC worker produced, so a marker was reported by a tile that could only
# see half the metal it is about. The five fork commits this build adds over the
# one 0.3.47 shipped are, oldest first:
#
#   b29b0a2fa6  drt: stop frMarker's copy constructor throwing away the rects (#18)
#   d6f66c0c95  drt: let the in-loop and whole-design GC passes ask the same question (#19)
#   87da2bc613  drt: dump the object set a GC worker holds at one point
#   d662c0fd5f  drt: a DRC marker belongs to the tile that owns it (#20)   <- THE FIX
#   fbfe6cae4d  drt: emit route__drc_errors_final (#21)                    metric-only
#
# Every PDK correction 0.3.47 made is INHERITED, not re-applied: it is already in
# the base layers, and re-running the install steps here would add layers to an
# image that is already 116 deep against a 125-layer pull limit. What IS re-run
# is `pdk_local_mods.py verify`, unchanged from 0.3.47 and against the same
# baseline -- because a derived build that does not re-state the volume
# assertion ships an unasserted volume, and the assertion is cheap.
#
# WHY DERIVED AND NOT A RELEASE COMPOSITION -- unchanged from 0.3.47.
# `docker buildx bake eda` needs the private ghcr.io/vibeic/eda-tool-* artefacts
# and no credential on these hosts has read:packages. Owner ruling 2026-09-07:
# build FROM the campaign digest and distribute by registry.
#
# THE BASE IS NAMED BY DIGEST; THE REPOSITORY IS DEPLOYMENT CONFIGURATION.
# 0.3.47 was never pushed to ghcr -- it exists in the fleet's private registry
# only -- so the default below names a repository that cannot currently serve
# this digest. That is deliberate: the digest is the identity and is written
# here; WHERE those bytes are fetched from is a fact about a network and is
# supplied at build time, the same split `_eda_pin.py` makes on the plugin side.
# No registry address is written into this repository.
#
#   docker build --build-arg BASE_IMAGE="$VIBEIC_EDA_IMAGE_REPO@sha256:8da785a8…"
#
# tools/build_derived.sh does exactly that and states what it asserted.
#
# Build context is NOT this repository. It is a staging directory holding:
#     bin/openroad  the fork build (see tools/build_derived.sh)
# The openroad binary is ~145 MB and is deliberately not committed here. Unlike
# 0.3.47 the context needs no pdk/ tree: /vibeic/pdk/ is already in the base.

ARG BASE_IMAGE=ghcr.io/vibeic/vibeic-eda@sha256:8da785a8d3275884ad0d0ee0fb10f7e90d8b7bf11a08d38e9559b0764112480f
FROM ${BASE_IMAGE}
USER root

# The contents assertion the base image's own PDK provenance rests on. Passed in
# so it lives in exactly one place; pdk_local_mods.py verify re-states it below.
# UNCHANGED from 0.3.47.
ARG OPEN_PDKS_VOLUME_CONTENTS_SHA=b344c97eacc2aaf8e14ae7e43e2e9dc0871de2c0

# Never leave a __pycache__ inside the tracked PDK volume: pdk_local_mods.py
# digests that volume and an undeclared .pyc is an undeclared added file.
ENV PYTHONDONTWRITEBYTECODE=1

# --- 1/1  OpenROAD, this org's fork at master fbfe6cae4d (post-#20, #21) -----
# Built from a clean checkout of exactly that sha, by the same recipe the
# published eda-tool-openroad artefact uses (tools/openroad/Dockerfile): full
# clone so `git describe` finds the 26Q3 tags, `build --stamp` in ~/.bazelrc so
# the binary can state which commit it is, then etc/Build.sh.
# /foss/tools/bin/openroad is a symlink to this path. openroad-librelane is a
# separate install and is deliberately untouched.
COPY bin/openroad /foss/tools/openroad/bin/openroad

# ONE layer for the assertion AND the volume re-statement, on purpose. The base
# is 116 filesystem layers against a 125-layer pull limit, so a derived
# generation that spends four layers is a generation nobody can stack on.
#
# An undeclared file in the tracked ciel volume fails the build naming it; an
# entry with no step behind it fails it too. Re-run here unchanged so this image
# asserts its own volume rather than inheriting somebody else's assertion.
RUN set -e; \
    chmod 0755 /foss/tools/openroad/bin/openroad; \
    V="$(/foss/tools/bin/openroad -version 2>&1 | tr -d '[:space:]')"; \
    [ "$V" = "26Q3-2070-gfbfe6cae4d" ] \
        || { echo "FAIL: openroad reports '$V', not the fork build 26Q3-2070-gfbfe6cae4d" >&2; exit 1; }; \
    printf 'openroad fbfe6cae4d8aa1e1291d1bb6aad3055a04efb7e8\n' > /foss/tools/openroad/SOURCES; \
    python3 /vibeic/pdk/pdk_local_mods.py verify \
        --root /foss/pdks/ciel \
        --baseline /vibeic/pdk/volume-as-delivered.sha256 \
        --manifest /vibeic/pdk/local_mods.json \
        --upstream-sha "${OPEN_PDKS_VOLUME_CONTENTS_SHA}" \
        --pdk-symlink /foss/pdks/sky130A \
        --pdk-symlink /foss/pdks/gf180mcuD \
        --record /foss/pdks/LOCAL_MODIFICATIONS.json; \
    echo "OK 1/1 openroad: $V; the ciel volume still verifies against 0.3.47's baseline"

LABEL org.opencontainers.image.version="0.3.48"
LABEL io.vibeic.derived.base="vibeic-eda@sha256:8da785a8d3275884ad0d0ee0fb10f7e90d8b7bf11a08d38e9559b0764112480f"
LABEL io.vibeic.derived.base.version="0.3.47"
LABEL io.vibeic.derived.changes="openroad replaced with the vibeic fork at fbfe6cae4d8aa1e1291d1bb6aad3055a04efb7e8 (master, carrying #20: a DRC marker belongs to the tile that owns it), reporting 26Q3-2070-gfbfe6cae4d. Five commits over 0.3.47's cad013df98: #18 frMarker copy ctor keeps its rects, #19 the two GC passes can be made to ask the same question, the GC object-set dump, #20 the marker-ownership fix, #21 route__drc_errors_final (metric-only). Every 0.3.47 PDK correction is inherited from the base and pdk_local_mods.py verify is re-run unchanged."
LABEL io.vibeic.derived.openroad.commit="fbfe6cae4d8aa1e1291d1bb6aad3055a04efb7e8"
LABEL io.vibeic.derived.built.by="lane czimage48 on 8hd-3, docker build FROM the 0.3.47 fleet-registry digest, never pushed to ghcr"

USER 1000
